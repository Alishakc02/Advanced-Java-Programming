//Random Access File


import java.io.*;

public class Demo {

    public static void main(String args[]) {

        try {

            RandomAccessFile r =
                new RandomAccessFile("abc.txt","rw");

            r.writeInt(500);

            r.seek(0);

            System.out.println(r.readInt());

            r.close();

        } catch(Exception e) {

            System.out.println(e);
        }
    }
}


