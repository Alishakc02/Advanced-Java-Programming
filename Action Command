import javax.swing.*;
import java.awt.event.*;

public class ActionCommandExample {

    public static void main(String[] args) {

        JFrame f = new JFrame("Action Command Example");

        JButton b1 = new JButton("Add");
        JButton b2 = new JButton("Subtract");

        b1.setBounds(100, 50, 100, 30);
        b2.setBounds(100, 100, 100, 30);

        // Set action commands
        b1.setActionCommand("ADD");
        b2.setActionCommand("SUB");

        ActionListener a = new ActionListener() {
            public void actionPerformed(ActionEvent e) {

                String cmd = e.getActionCommand();

                if(cmd.equals("ADD")) {
                    System.out.println("Add button clicked");
                }
                else if(cmd.equals("SUB")) {
                    System.out.println("Subtract button clicked");
                }
            }
        };

        b1.addActionListener(a);
        b2.addActionListener(a);

        f.add(b1);
        f.add(b2);

        f.setSize(300, 250);
        f.setLayout(null);
        f.setVisible(true);
    }
}
